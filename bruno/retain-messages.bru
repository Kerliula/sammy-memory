meta {
  name: Retain messages
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/workspaces/{{workspaceId}}/sessions/{{sessionId}}/messages
  body: json
  auth: none
}

body:json {
  {
    "messages": [
      {
        "id": "{{$randomUUID}}",
        "participant": "user-1",
        "content": "Hello Sammy",
        "sent_at": "{{$isoTimestamp}}"
      }
    ]
  }
}

assert {
  res.status: eq 202
}

docs {
  The workspace must already exist; there is no endpoint to create one.
  Insert it first:

  ```
  docker compose exec db psql -U sammy -d sammy -c "INSERT INTO workspaces (id, name) VALUES ('11111111-1111-1111-1111-111111111111', 'test') ON CONFLICT DO NOTHING;"
  ```

  The session and participant are created on first use. `{{$randomUUID}}`
  gives each send a new message id; paste a fixed id instead to check that
  a retry is skipped.
}
